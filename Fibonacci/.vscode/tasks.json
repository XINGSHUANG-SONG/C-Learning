{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build active C file",
            "command": "gcc",
            "args": [
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-std=c17",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-g"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}